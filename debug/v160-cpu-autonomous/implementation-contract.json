  "jsonNativeNormalization": {
    "functionContract": "json_native(value)",
    "decisionSemantics": "Structural PASS/FAIL is computed from the original logical checks using bool(value) exactly as in V159 before normalization. Normalization is serialization-only and may not alter the decision.",
    "checkMapContract": "After the decision is computed, construct native_checks = {key: bool(value) for key, value in checks.items()} and place native_checks, not raw checks, into the receipt.",
    "orderedRules": [
      "If value is None, return None.",
      "If value is a native str, bool, or int, return it unchanged.",
      "If value is a native float, require math.isfinite(value); otherwise raise RuntimeError; return the finite float unchanged.",
      "If value is numpy.generic, call value.item() and recursively normalize the result.",
      "If value is numpy.ndarray, call value.tolist() and recursively normalize the result.",
      "If value is list or tuple, return a list containing recursively normalized elements in original order.",
      "If value is dict, require every key to be native str and return a dict with recursively normalized values preserving insertion keys.",
      "For every unsupported type, raise RuntimeError before receipt write."
    ],
    "serialization": {
      "encoder": "json.dumps",
      "indent": 2,
      "sortKeys": true,
      "allowNan": false,
      "trailingNewline": true
    }
  },
  "mandatorySyntheticStaticFixture": {
    "mustRunBeforeAnySongAudio": true,
    "control": "json.dumps on {'x': numpy.bool_(True)} must raise TypeError, proving the fixture would have caught V159.",
    "fixtureValues": {
      "boolScalar": "numpy.bool_(True)",
      "integerScalar": "numpy.int64(7)",
      "floatingScalar": "numpy.float64(1.25)",
      "array": "numpy.asarray([[1,2],[3,4]], dtype=numpy.int64)",
      "nested": "dict/list/tuple combination containing all preceding NumPy types"
    },
    "postNormalizationAssertions": [
      "No numpy.generic remains recursively.",
      "No numpy.ndarray remains recursively.",
      "All synthetic check-map values are type(value) is bool.",
      "json.dumps(normalized, allow_nan=False, sort_keys=True) succeeds.",
      "json.loads round-trip equals expected native structure.",
      "native float NaN and infinity are rejected before or by allow_nan=False."
    ]
  },
