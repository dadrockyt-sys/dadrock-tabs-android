{
  "baselineVersion": 7,
  "baselineName": "jimmy-paige-v7-full-stack",
  "benchmarkType": "combined-v7-full-stack-audio-path",
  "requiredChecks": [
    "rhythmContextEnabled",
    "rhythmPromotesE",
    "rhythmPromotesG",
    "rhythmPreservesG6",
    "rhythmPreservesATp2",
    "rhythmProductionUnchanged",
    "leadContextEnabled",
    "leadDetectsBend",
    "leadDetectsRelease",
    "leadDetectsPalmMute",
    "leadProductionUnchanged",
    "bassContextEnabled",
    "bassDetectsFiveSevenContour",
    "bassDetectsSlide",
    "bassDetectsMute",
    "bassDetectsRest",
    "bassProductionUnchanged",
    "rhythmReceivesNoLeadAnalysis",
    "rhythmReceivesNoBassAnalysis",
    "leadReceivesNoChordAnalysis",
    "leadReceivesNoBassAnalysis",
    "bassReceivesNoChordAnalysis",
    "bassReceivesNoLeadAnalysis",
    "rhythmNoSyntheticNotes",
    "leadNoSyntheticNotes",
    "bassNoSyntheticNotes",
    "allTabsPresent"
  ],
  "requiredRhythmVocabulary": ["A(tp2)", "D", "E", "G", "G6"],
  "requiredRhythmPromotions": ["E", "G"],
  "minimumLeadReleasePairs": 1,
  "minimumLeadPalmMutedEvents": 1,
  "requiredBassContour": true,
  "requiredBassSlideTarget": 14,
  "protectedBaselinesChanged": false,
  "protectionRule": "Future V7 work must preserve instrument isolation, generated tabs, event arrays, note counts, MIDI pitches, frets, and timing. Diagnostics remain opt-in and may not synthesize or retune notes."
}
