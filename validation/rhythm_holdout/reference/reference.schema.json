{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadrocktabs.com/schemas/rhythm-professional-holdout-reference-v1.json",
  "title": "DadRock Rhythm Professional Human Holdout Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instrument",
    "holdout",
    "completeReference",
    "source",
    "timeSignature",
    "tuning",
    "measures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instrument": { "const": "rhythm" },
    "holdout": { "const": true },
    "completeReference": { "const": true },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "provenance"],
      "properties": {
        "kind": { "const": "professional-human-tab" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "provenance": { "type": "string", "minLength": 1 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "tempoBpm": { "type": "number", "exclusiveMinimum": 0 },
    "timeSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beats", "noteValue"],
      "properties": {
        "beats": { "type": "integer", "minimum": 1 },
        "noteValue": { "type": "integer", "enum": [1, 2, 4, 8, 16, 32] }
      }
    },
    "stepsPerMeasure": { "const": 16 },
    "tuning": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "events"],
        "properties": {
          "measure": { "type": "integer", "minimum": 1 },
          "section": { "type": ["string", "null"] },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "notes"],
              "properties": {
                "step": { "type": "integer", "minimum": 0, "maximum": 15 },
                "durationSteps": { "type": ["integer", "null"], "minimum": 1 },
                "rest": { "type": "boolean", "default": false },
                "tieIn": { "type": "boolean", "default": false },
                "tieOut": { "type": "boolean", "default": false },
                "techniques": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string" },
                  "default": []
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["stringIndex", "fret", "midi"],
                    "properties": {
                      "stringIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
                      "fret": { "type": "integer", "minimum": 0, "maximum": 36 },
                      "midi": { "type": "integer", "minimum": 40, "maximum": 100 },
                      "durationSteps": { "type": ["integer", "null"], "minimum": 1 },
                      "tieIn": { "type": "boolean", "default": false },
                      "tieOut": { "type": "boolean", "default": false },
                      "techniques": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": { "type": "string" },
                        "default": []
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
